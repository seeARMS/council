{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "council-web",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Only the page and its Markdown go through the Worker, which picks
		// between them by Accept header. Every other file, the hero video
		// included, is served straight from the assets.
		"run_worker_first": ["/", "/index.md"]
	},
	"observability": {
		"enabled": true
	}
}